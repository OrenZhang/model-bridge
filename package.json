{
  "name": "model-bridge",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "One local model gateway for Codex, Claude Code and other agents.",
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build && node dist/cli.js",
    "build": "node scripts/build-installer.mjs && tsc && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs",
    "icons": "node scripts/build-icons.mjs",
    "start": "node dist/cli.js",
    "desktop": "npm run build && electron .",
    "check": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder --publish never",
    "pretest": "node scripts/build-installer.mjs",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "@openai/codex": "0.144.1",
    "fflate": "^0.8.2",
    "smol-toml": "^1.4.2",
    "undici": "8.12.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "electron": "45.2.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "build": {
    "asarUnpack": [
      "node_modules/@openai/**/*",
      "node_modules/@napi-rs/**/*",
      "dist/network/runner.js"
    ],
    "appId": "io.github.orenzhang.modelbridge",
    "productName": "Model Bridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "executableName": "model-bridge"
    },
    "deb": {
      "maintainer": "OrenZhang"
    }
  },
  "homepage": "https://github.com/OrenZhang/model-bridge",
  "author": {
    "name": "OrenZhang"
  }
}
