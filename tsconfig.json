{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist", "rootDir": "src",
    "sourceMap": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/ui"]
}
